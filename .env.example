# ─────────────────────────────────────────────────────────────
# AGR Platform — Environment Variables
# Copy to services/agr-api/.env and fill in values.
# ─────────────────────────────────────────────────────────────

# ── Database (required — used by docker-compose.yml) ──────────
POSTGRES_USER=agr_svc_usr
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=agr_platform

# ── Required ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agr:password@localhost:5432/agr_dev
SECRET_KEY=change-me-run-openssl-rand-hex-32   # used for HMAC token signing

# ── Required with working local defaults ──────────────────────
REDIS_URL=redis://localhost:6379
ENV=development                    # development | production | test
API_BASE_URL=http://localhost:8000 # base URL used in email + Slack approve/reject links

# ── Temporal (optional — leave blank to disable durable workflows) ──
TEMPORAL_HOST=                     # e.g. localhost:7233 — empty = DB-only approval tracking
TEMPORAL_NAMESPACE=default

# ── Email notifications (optional) ────────────────────────────
RESEND_API_KEY=                    # re_... — blank = approval emails disabled

# ── Slack notifications (optional) ────────────────────────────
SLACK_BOT_TOKEN=                   # xoxb-... — blank = Slack notifications disabled
SLACK_CHANNEL_ID=                  # e.g. C0123456789 — blank = Slack notifications disabled

# ── Clerk (dashboard authentication) ──────────────────────────
CLERK_WEBHOOK_SECRET=              # whsec_... — blank = Svix verification skipped (safe for dev)
CLERK_SECRET_KEY=                  # sk_test_...
CLERK_PUBLISHABLE_KEY=             # pk_test_... (also set in apps/agr-dashboard/src/environments/)

# ── Copilot (LLM-powered policy assistant) — paid plans only ──
ANTHROPIC_API_KEY=                    # sk-ant-... from console.anthropic.com — empty = copilot disabled
COPILOT_MODEL=claude-sonnet-4-20250514
