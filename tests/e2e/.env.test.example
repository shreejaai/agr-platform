# Copy this file to .env.test and fill in your values.
# .env.test is gitignored — never commit real API keys.

# Required: AGR instance URL (local or hosted)
AGR_BASE_URL=http://localhost:8000

# Required: API key from your AGR test org
# Get it from: docker compose logs agr-api | grep "API Key"
# Or from the dashboard: Settings → API Keys → Create scoped key
AGR_API_KEY=agr_sk_your_test_key_here
