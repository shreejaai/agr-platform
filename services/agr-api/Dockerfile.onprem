# AGR API — On-Premises Distribution Build
# ─────────────────────────────────────────────────────────────────────────────
# 4-stage build:
#   Stage 1 (deps)         — install Python packages
#   Stage 2 (cedar-builder)— compile Cedar CLI from Rust source
#   Stage 3 (cython-build) — compile .py → .so (protects source code)
#   Stage 4 (runtime)      — lean image with binaries only, no .py source
#
# Build context: repo root
#   docker build -f services/agr-api/Dockerfile.onprem -t agr-api:onprem .

# ── Stage 1: Python dependencies ─────────────────────────────────────────────
FROM python:3.12-slim AS deps
WORKDIR /build
COPY services/agr-api/requirements.txt .
# Include cryptography for license validation (may already be in requirements.txt)
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt \
    && pip install --no-cache-dir --prefix=/install cryptography

# ── Stage 2: Cedar CLI (Rust) ─────────────────────────────────────────────────
FROM rust:slim AS cedar-builder
RUN cargo install cedar-policy-cli --quiet

# ── Stage 3: Cython compilation ───────────────────────────────────────────────
FROM python:3.12-slim AS cython-build
WORKDIR /src

# Copy installed packages so Cython can find FastAPI/SQLAlchemy type stubs
COPY --from=deps /install /usr/local

# Source to compile
COPY services/agr-api/ .
COPY packages/ /packages/

# Install build tools + Cython
RUN pip install --no-cache-dir cython setuptools \
    && apt-get update -qq && apt-get install -y --no-install-recommends gcc libc-dev \
    && rm -rf /var/lib/apt/lists/*

# Compile .py → .so  (parallel, 4 threads)
RUN python setup_cython.py build_ext --inplace

# Remove Python source files, keeping only:
#   - Compiled .so binaries (the protected code)
#   - __init__.py (package markers — required by Python import system)
#   - main.py (uvicorn entry point — cannot be compiled away)
#   - config.py (pydantic-settings reads source at import time)
RUN find app -name "*.py" \
    ! -name "__init__.py" \
    ! -name "main.py" \
    ! -name "config.py" \
    -not -path "*/workers/*" \
    -not -path "*/workflows/*" \
    -delete

# Remove any leftover .c files generated by Cython
RUN find app -name "*.c" -delete

# ── Stage 4: Lean runtime ─────────────────────────────────────────────────────
FROM python:3.12-slim

# Non-root user
RUN groupadd --gid 1001 agr && useradd --uid 1001 --gid agr --no-create-home agr

WORKDIR /app

# Python packages
COPY --from=deps /install /usr/local

# Cedar CLI binary
COPY --from=cedar-builder /usr/local/cargo/bin/cedar /usr/local/bin/cedar

# Compiled app (mix of .so + the few .py files kept above)
COPY --from=cython-build --chown=agr:agr /src/app ./app
COPY --from=cython-build --chown=agr:agr /src/infra ./infra

# agr-core package
COPY --chown=agr:agr packages/ /packages/

USER agr

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
