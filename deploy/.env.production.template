# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=agr_svc_usr
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=agr_platform

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32

# ── Clerk Auth (dashboard uses the key baked into the ghcr.io image) ──────────
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── GitHub Container Registry (if packages are private) ───────────────────────
# Leave blank if ghcr.io/shreejaai packages are public
GHCR_TOKEN=

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_REPLACE_ME

# ── Slack (optional — leave blank to disable) ──────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=

# ── App URLs — set to your GCP VM external IP or domain ───────────────────────
API_BASE_URL=http://YOUR_GCP_EXTERNAL_IP:8000
DASHBOARD_BASE_URL=http://YOUR_GCP_EXTERNAL_IP:4200
ENV=production

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# ── Cedar policy fallback behaviour ───────────────────────────────────────────
CEDAR_FALLBACK_MODE=warn

# ── AI Copilot (optional) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-sonnet-4-6
