# AGR On-Premises — Environment Configuration
# Copy this file to .env.onprem and fill in all values before starting.
# ─────────────────────────────────────────────────────────────────────────────

# AGR image version (provided by Shreeja AI with your license)
AGR_VERSION=1.0.0

# License key issued by Shreeja AI — required, app will not start without it
AGR_LICENSE_KEY=REPLACE_WITH_YOUR_LICENSE_KEY

# Your organization name (shown in dashboard and audit logs)
ORG_NAME=Acme Corp

# Strong random secrets — generate with: openssl rand -hex 32
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SECRET_KEY=REPLACE_WITH_STRONG_SECRET

# Public URL where the API is reachable (used in approval email/Slack links)
API_BASE_URL=https://agr.your-company.com

# Ports (defaults: API=8000, Dashboard=80)
API_PORT=8000
DASHBOARD_PORT=80

# ── Optional: Slack approvals ─────────────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C0123456789

# ── Optional: Email approvals via Resend ─────────────────────────────────────
# RESEND_API_KEY=re_...

# ── Optional: Clerk dashboard authentication ─────────────────────────────────
# Required if you want Clerk-backed sign-in in production/on-prem.
# Use live keys for production deployments.
# CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...
# CLERK_WEBHOOK_SECRET=whsec_...
